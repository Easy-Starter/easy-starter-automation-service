APP_NAME=Easy Starter Automation Service
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_DOCS_ENABLED=true

DATABASE_URL=postgresql+psycopg://automation:automation@postgres:5432/automation

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

WEBHOOK_SIGNING_SECRET=replace-me
INTERNAL_API_KEY=replace-me

CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840

OTEL_ENABLED=false
OTEL_SERVICE_NAME=easy-starter-automation-service
OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=